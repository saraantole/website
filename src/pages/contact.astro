---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";

const pageTitle = "Contact";
---

<Layout pageTitle={pageTitle} pageDescription="Get in touch with Sara Antole">
  <section class="contact-section">
    <div class="contact-wrapper">
      <div class="contact-copy">
        <h2>Say hello</h2>
        <p class="contact-intro">
          Questions, ideas, or something you're working on. All forms lead to
          Rome and I answer them all.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  .contact-section {
    width: 100%;
    background: var(--color-background);
    padding: 200px 0 20px 0;
  }

  .contact-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-evenly;
    align-items: flex-start;
    padding: 0 80px;
    gap: 60px;
  }

  .contact-copy {
    width: 30vw;
  }

  h2 {
    font-weight: 700;
    font-size: clamp(108px, 4.5vw, 4.5em);
    letter-spacing: 2px;
    line-height: 1.2;
    margin: 0;
    color: var(--color-text);
  }

  .contact-intro {
    margin: 2rem 0 0 0;
    max-width: 42ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 40px 0 80px 0;
    }
    .contact-wrapper {
      flex-direction: column;
      padding: 0 40px;
      gap: 40px;
    }

    .contact-copy {
      width: 100%;
    }

    h2 {
      font-size: 48px;
      line-height: 60px;
    }
  }
</style>
